<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/blue_background">

        <!-- FILTROS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnDesde"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Desde" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <Button
                android:id="@+id/btnHasta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Hasta" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <Button
                android:id="@+id/btnFiltrar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Filtrar" />
        </LinearLayout>

        <!-- BUSCADOR POR SG -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:hint="Buscar por SG..."
            android:background="@color/blue_surface"
            android:padding="12dp"
            android:inputType="text" />

        <!-- TOTALES DEL RANGO -->
        <TextView
            android:id="@+id/tvResumenRango"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen: -"
            android:textColor="@color/blue_onBackground"
            android:layout_marginTop="10dp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>