<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== Card editable (Fase 4c) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_editar_parametros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar parámetros"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:text="Estos cambios afectan los cálculos de todos los días (pasados y futuros). Los tramos por SKU, los valores de KM por fecha y las reglas de día de la semana NO son configurables." />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Valor por SKU ($)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etValorSku"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Comisión (%)"
                    app:helperText="Ej: 15.25 (no 0.1525)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Rendimiento (km / litro)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRendimiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Precio del litro ($)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrecioLitro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Bono por km (lun/mar) ($)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBonoKm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnRestaurarParams"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurar defaults" />

                    <Button
                        android:id="@+id/btnGuardarParams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Guardar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ===== Card informativa: valores vigentes (refleja Prefs) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_parametros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valores vigentes"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvValorSku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor por SKU: $61" />

                <TextView
                    android:id="@+id/tvValorKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor por KM: $276 (valor TRANSITORIO) " />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_parametros_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parámetros de cálculo Base"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mill600"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="De 1 a 10 SKU : $2.623" />

                <TextView
                    android:id="@+id/tresk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="De 11 a 30 SKU : $3.026" />

                <TextView
                    android:id="@+id/cuatrok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="De 31 a 50 SKU : $4.035 " />
                <TextView
                    android:id="@+id/cincok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="De 51 a 70 SKU : $5.044 " />
                <TextView
                    android:id="@+id/sietek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="De 71 a 90 SKU : $7.061 " />
                <TextView
                    android:id="@+id/ochok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="De 91 a 125 SKU : $8.070 " />
                <TextView
                    android:id="@+id/muevek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="126 de 150 SKU : $9.079 " />
                <TextView
                    android:id="@+id/diezk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mas de 151 SKU : $10.088 " />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
